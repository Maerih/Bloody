{
  "name": "bloody",
  "private": true,
  "description": "Bloody \u2014 unified Security Operating Platform and Command Center",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "lint": "pnpm -r run lint",
    "dev:api": "pnpm --filter @bloody/api dev",
    "dev:web": "pnpm --filter @bloody/web dev",
    "db:migrate": "pnpm --filter @bloody/api migrate",
    "db:seed": "pnpm --filter @bloody/api seed:dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2"
    ]
  }
}
