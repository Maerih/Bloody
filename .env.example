#
# Bloody — environment template. NEVER commit a filled-in copy (.env* is git-ignored).
#
#   Docker Compose:   cp .env.example infra/.env      (compose reads .env from infra/, the project dir)
#   Host-run API:     export the "API runtime" block (or use your shell's env loader) before `pnpm dev:api`
#   Kubernetes:       non-secret values → infra/k8s ConfigMap; secrets → your secret store (ExternalSecret)
#
# Every default in the compose files is a development-only value. Anything marked [secret] must
# be generated per environment, e.g. `openssl rand -base64 48`, and stored in a secret manager.

# ─── API runtime ──────────────────────────────────────────────────────────────────────────
NODE_ENV=development
# development | staging | production. In production the API refuses known development secrets.
BLOODY_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
BLOODY_PUBLIC_URL=http://localhost:8080
# Comma-separated allow-list; never "*".
BLOODY_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# true behind HTTPS (always in staging/production).
BLOODY_COOKIE_SECURE=false
# true only when a trusted reverse proxy / ingress sets X-Forwarded-*.
BLOODY_TRUST_PROXY=false

# Runtime role: DML only, RLS enforced (see infra/postgres/init). [secret]
DATABASE_URL=postgres://bloody_app:change-me@localhost:5432/bloody
# Schema owner, used ONLY by migrations (`pnpm db:migrate`). [secret]
DATABASE_MIGRATION_URL=postgres://bloody_owner:change-me@localhost:5432/bloody
DATABASE_POOL_MAX=20
# Integration tests (vitest) — superuser on the throw-away bloody_test database.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/bloody_test

# Valkey (Redis protocol): rate limits, caches, short-lived state. [secret]
VALKEY_URL=redis://:change-me@localhost:6379/0

# JWT signing secret (≥ 32 bytes of entropy). [secret]
BLOODY_JWT_SECRET=
# AES-256-GCM key for credentialRef secrets: base64 of exactly 32 random bytes
# (`openssl rand -base64 32`). Production: a KMS-wrapped data key. [secret]
BLOODY_ENCRYPTION_KEY=

# Event fabric: memory (single process) | kafka
BLOODY_EVENT_BUS=memory
KAFKA_BROKERS=localhost:9092
# Empty = event search served from Postgres; e.g. http://localhost:9200 with the `search` profile.
OPENSEARCH_URL=

# Scheduler (scheduled reports, automation rules, SLA timers). Exactly one process should run it.
BLOODY_SCHEDULER_ENABLED=true

# SMTP for notifications and scheduled reports (Mailpit in dev: localhost:1025, STARTTLS).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=bloody
SMTP_PASSWORD=
SMTP_FROM=notifications@bloody.local
SMTP_FROM_NAME=Bloody Security Operations
# Extra CA bundle (the dev CA from scripts/dev-certs.sh). Certificate verification is never disabled.
NODE_EXTRA_CA_CERTS=

# AI providers are configured per tenant/org in the UI (Settings → AI). Allow private-network
# model endpoints (Ollama / vLLM on 10.x, 192.168.x …) only when you run local models.
BLOODY_AI_ALLOW_PRIVATE_ENDPOINTS=false

# SSO (OIDC relying party — Keycloak, Entra ID, Okta …). Empty issuer = local accounts only.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=bloody
OIDC_CLIENT_SECRET=

# Platform telemetry (OpenTelemetry). Empty = disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=bloody-api

# ─── Web build (baked into the SPA at build time; unset = link hidden) ────────────────────
VITE_SALES_CONTACT_URL=
VITE_SUPPORT_URL=
VITE_DOCS_URL=
VITE_FEEDBACK_URL=
VITE_HUB_URL=
# `pnpm dev:web` proxies /api here.
BLOODY_API_URL=http://localhost:4000

# ─── docker-compose.yml (core) overrides ──────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
BLOODY_DB_OWNER_PASSWORD=
BLOODY_DB_APP_PASSWORD=
VALKEY_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
BLOODY_OIDC_CLIENT_SECRET=
# Host ports (bound to 127.0.0.1)
POSTGRES_PORT=5432
API_PORT=4000
WEB_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
KEYCLOAK_PORT=8180
GIT_SHA=dev

# ─── docker-compose.engines.yml (engine layer) ────────────────────────────────────────────
# Collectors → Bloody: http (POST /api/v1/ingest/events) | kafka (bloody.raw.<adapter>)
BLOODY_INGEST_TRANSPORT=http
BLOODY_INGEST_URL=http://api:4000/api/v1/ingest/events
# API key of a service principal with role api_service (event:ingest). [secret]
BLOODY_INGEST_API_KEY=
# Integration id the collector is registered as (Settings → Integrations).
BLOODY_INTEGRATION_ID=
# OTel collector engine-log pipelines: off (Vector handles engine logs) | kafka | http
BLOODY_OTEL_ENGINE_LOGS=off
# Live capture interface for Zeek / Suricata (host networking).
CAPTURE_INTERFACE=eth0

# Shared engine infrastructure [secret]
ENGINE_VALKEY_PASSWORD=
ENGINE_RABBITMQ_USER=bloody-engines
ENGINE_RABBITMQ_PASSWORD=
ENGINE_S3_ACCESS_KEY=bloody-engines
ENGINE_S3_SECRET_KEY=
ENGINE_MARIADB_ROOT_PASSWORD=
ENGINE_POSTGRES_PASSWORD=
KAFKA_CLUSTER_ID=

# endpoint [secret]
WAZUH_INDEXER_PASSWORD=
WAZUH_API_PASSWORD=
WAZUH_AGENT_BIND=127.0.0.1
# Velociraptor image build: version + SHA-256 of the upstream release binary (mandatory).
VELOCIRAPTOR_VERSION=0.76.3
VELOCIRAPTOR_SHA256=
VELOCIRAPTOR_ADMIN_PASSWORD=
VELOCIRAPTOR_FRONTEND_HOSTNAME=localhost

# network [secret]
ARKIME_PASSWORD_SECRET=
ARKIME_SERVER_SECRET=
ARKIME_ADMIN_PASSWORD=

# intel [secret]
MISP_ADMIN_PASSWORD=
# exactly 40 characters
MISP_ADMIN_KEY=
MISP_DB_PASSWORD=
OPENCTI_ADMIN_PASSWORD=
# UUIDv4
OPENCTI_ADMIN_TOKEN=
OPENCTI_HEALTH_ACCESS_KEY=

# case / soar / vuln / cloud / forensics / copilot [secret]
IRIS_DB_PASSWORD=
IRIS_DB_ADMIN_PASSWORD=
IRIS_SECRET_KEY=
IRIS_SECURITY_PASSWORD_SALT=
IRIS_ADMIN_PASSWORD=
IRIS_ADMIN_API_KEY=
SHUFFLE_ADMIN_PASSWORD=
SHUFFLE_API_KEY=
SHUFFLE_ENCRYPTION_MODIFIER=
GVMD_ADMIN_PASSWORD=
# Greenbone publishes rolling tags; pin a digest in production.
GREENBONE_VERSION=stable
TRIVY_SERVER_TOKEN=
TIMESKETCH_SECRET_KEY=
TIMESKETCH_DB_PASSWORD=
TIMESKETCH_ADMIN_PASSWORD=
COPILOT_DB_PASSWORD=
