{
  "name": "@bloody/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Bloody control plane & unified API (multi-tenant, RBAC, audit).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json --noEmit && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "seed:dev": "tsx src/db/seed-dev.ts"
  },
  "dependencies": {
    "@bloody/contracts": "workspace:*",
    "@bloody/engines": "workspace:*",
    "@bloody/ai": "workspace:*",
    "@bloody/adapters": "workspace:*",
    "@bloody/automation": "workspace:*",
    "@bloody/reporting": "workspace:*",
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/cookie": "^11.0.1",
    "pg": "^8.13.1",
    "jose": "^5.9.6",
    "@node-rs/argon2": "^2.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5"
  }
}
